{
  "comments": {
    "lineComment": "#",
    "blockComment": ["#=", "=#"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["do", "end"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "do", "close": "\nend", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "\\b(do|#=)\\b",
      "end": "\\b(end|=#)\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "\\b(do|else|elif)\\s*$",
    "decreaseIndentPattern": "^\\s*(end|else|elif|catch)\\b"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*"
}
