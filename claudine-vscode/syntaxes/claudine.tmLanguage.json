{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Claudine",
  "scopeName": "source.claudine",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.claudine",
          "begin": "#=",
          "end": "=#",
          "captures": {
            "0": { "name": "punctuation.definition.comment.claudine" }
          }
        },
        {
          "name": "comment.line.number-sign.claudine",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.claudine",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.claudine" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.claudine" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.claudine",
              "match": "\\\\[ntr\\\\\"{}]"
            },
            {
              "name": "meta.interpolation.claudine",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.claudine" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.claudine" }
              },
              "patterns": [
                { "include": "source.claudine" }
              ]
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.claudine",
          "match": "\\b(if|else|elif|for|in|while|match|case|return|break|continue|try|catch|import|as)\\b"
        },
        {
          "name": "keyword.declaration.claudine",
          "match": "\\b(let|var|fn|struct)\\b"
        },
        {
          "name": "keyword.other.claudine",
          "match": "\\b(do|end|args|arg|option|flag)\\b"
        },
        {
          "name": "keyword.operator.logical.claudine",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "variable.language.self.claudine",
          "match": "\\bself\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.claudine",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.claudine",
          "match": "=>"
        },
        {
          "name": "keyword.operator.range.claudine",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.claudine",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.claudine",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.claudine",
          "match": "[+\\-*/%]"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.io.claudine",
          "match": "\\b(print|println|input|read_file|write_file|append_file|file_exists)\\b"
        },
        {
          "name": "support.function.string.claudine",
          "match": "\\b(split|join|trim|replace|contains|starts_with|ends_with|length|upper|lower)\\b"
        },
        {
          "name": "support.function.list.claudine",
          "match": "\\b(push|pop|map|filter|reduce|sort|reverse|flatten|zip|sum)\\b"
        },
        {
          "name": "support.function.map.claudine",
          "match": "\\b(keys|values|has_key|merge)\\b"
        },
        {
          "name": "support.function.math.claudine",
          "match": "\\b(abs|min|max|floor|ceil|round|sqrt|random)\\b"
        },
        {
          "name": "support.function.type.claudine",
          "match": "\\b(type_of|to_string|to_int|to_float)\\b"
        },
        {
          "name": "support.function.system.claudine",
          "match": "\\b(exec|env|exit|sleep|throw|range)\\b"
        },
        {
          "name": "support.function.ai.claudine",
          "match": "\\b(ask)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.claudine",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.claudine",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.claudine",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.claudine",
          "match": "\\bnil\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.claudine",
          "match": "(?<=fn\\s)[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.type.claudine",
          "match": "(?<=struct\\s)[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.claudine",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
